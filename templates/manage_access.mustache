{{! @template block_mark_manager/manage_access }}

<div class="block-mark-manager-access-page">
    {{! Заголовок страницы }}
    <h2 class="mb-4">{{pageheading}}</h2>

    {{! Ссылка возврата к курсу }}
    <div class="mb-3">
        <a href="{{backurl}}" class="btn btn-link p-0">
            <span class="dir-rtl-hide">&rarr;</span>
            <span class="dir-ltr-hide">&larr;</span>
            {{backtext}}
        </a>
    </div>

    {{! Секция поиска пользователей для добавления }}
    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">{{searchusersheading}}</h4>
        </div>
        <div class="card-body">
            {{! Форма поиска }}
            <form method="get" action="{{baseurl}}" class="form-inline mb-3" id="search-users-form">
                <input type="hidden" name="blockid" value="{{blockid}}">
                <input type="hidden" name="courseid" value="{{courseid}}">
                <div class="form-group mr-2">
                    <label for="search" class="sr-only">{{searchusersheading}}</label>
                    <input type="text" 
                           class="form-control" 
                           id="search"
                           name="search" 
                           value="{{search}}" 
                           placeholder="{{searchplaceholder}}"
                           style="min-width: 300px;">
                </div>
                <button type="submit" class="btn btn-primary">{{#str}}search{{/str}}</button>
                {{#search}}
                    <a href="{{baseurl}}" class="btn btn-secondary ml-2">{{#str}}clear{{/str}}</a>
                {{/search}}
            </form>

            {{! Сообщение, если ничего не найдено }}
            {{#nousersfound}}
                <div class="alert alert-info d-flex align-items-center" role="alert">
                    <span class="mr-2">{{#pix}}i/info{{/pix}}</span>
                    <span>{{#str}}nousersfound, block_mark_manager{{/str}}</span>
                </div>
            {{/nousersfound}}

            {{! Таблица найденных пользователей }}
            {{#hassearchusers}}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">{{fullnameheading}}</th>
                                <th scope="col">{{emailheading}}</th>
                                <th scope="col">{{actionsheading}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#searchusers}}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <a href="{{profileurl}}" class="font-weight-bold">
                                                {{fullname}}
                                            </a>
                                        </div>
                                    </td>
                                    <td>{{email}}</td>
                                    <td>
                                        <a href="{{addurl}}" 
                                           class="btn btn-sm btn-success"
                                           data-action="add-access"
                                           data-userid="{{userid}}">
                                            {{addtext}}
                                        </a>
                                    </td>
                                </tr>
                            {{/searchusers}}
                        </tbody>
                    </table>
                </div>

                {{! Пагинация }}
                {{#haspaging}}
                    <nav aria-label="{{#str}}pagination, core{{/str}}" class="mt-3">
                        {{{pagingbar}}}
                    </nav>
                {{/haspaging}}
            {{/hassearchusers}}
        </div>
    </div>

    {{! Секция пользователей с индивидуальным доступом }}
    <div class="card">
        <div class="card-header">
            <h4 class="mb-0">{{accessusersheading}}</h4>
        </div>
        <div class="card-body">
            {{! Сообщение, если нет пользователей с доступом }}
            {{#nouserhasaccess}}
                <div class="alert alert-info d-flex align-items-center" role="alert">
                    <span class="mr-2">{{#pix}}i/info{{/pix}}</span>
                    <span>{{#str}}nouserhasaccess, block_mark_manager{{/str}}</span>
                </div>
            {{/nouserhasaccess}}

            {{! Таблица пользователей с доступом }}
            {{#hasaccessusers}}
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="thead-light">
                            <tr>
                                <th scope="col">{{fullnameheading}}</th>
                                <th scope="col">{{emailheading}}</th>
                                <th scope="col">{{dategrantedheading}}</th>
                                <th scope="col">{{actionsheading}}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#accessusers}}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <a href="{{profileurl}}" class="font-weight-bold">
                                                {{fullname}}
                                            </a>
                                        </div>
                                    </td>
                                    <td>{{email}}</td>
                                    <td>
                                        <span class="text-muted">{{dategranted}}</span>
                                    </td>
                                    <td>
                                        <a href="{{removeurl}}" 
                                           class="btn btn-sm btn-danger"
                                           data-action="remove-access"
                                           data-userid="{{userid}}"
                                           onclick="return confirm('{{confirmtext}}');">
                                            {{removetext}}
                                        </a>
                                    </td>
                                </tr>
                            {{/accessusers}}
                        </tbody>
                    </table>
                </div>
            {{/hasaccessusers}}
        </div>
    </div>
</div>