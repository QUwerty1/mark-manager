{{! @template block_mark_manager/grading_assign }}
{{#issubmitted}}
<form class="mm-grade-form"
      data-type="{{typeidentifier}}"
      data-workid="{{workid}}"
      data-userid="{{userid}}"
      onsubmit="return false;">
    <div class="mm-grade-header mb-3 pb-3 border-bottom">
        <div class="d-flex justify-content-between align-items-start mb-1">
            <h5 class="mb-0">{{studentname}}</h5>
            <a href="{{gradingurl}}"
               class="btn btn-outline-secondary btn-sm ml-2 flex-shrink-0"
               title="{{#str}} openfullgrading, block_mark_manager {{/str}}">
                <i class="fa fa-external-link mr-1"></i>
                {{#str}} openfullgrading, block_mark_manager {{/str}}
            </a>
        </div>
        <p class="text-muted mb-1">{{workname}}</p>
        {{#hasduedate}}
            <small class="text-muted">
                <strong>{{#str}} duedate, block_mark_manager {{/str}}:</strong> {{duedateformatted}}
            </small>
        {{/hasduedate}}
    </div>

    <div class="mm-submission-block mb-3">
        <h6 class="text-muted text-uppercase small font-weight-bold">
            {{#str}} submissiontext, block_mark_manager {{/str}}
        </h6>
        {{#hassubmissiontext}}
            <div class="mm-submission-text border rounded p-3 bg-light">
                {{{submissiontext}}}
            </div>
        {{/hassubmissiontext}}
        {{^hassubmissiontext}}
            <div class="text-muted font-italic p-2">
                {{#str}} nosubmissiontext, block_mark_manager {{/str}}
            </div>
        {{/hassubmissiontext}}
    </div>

    <div class="mm-files-block mb-3">
        <h6 class="text-muted text-uppercase small font-weight-bold">
            {{#str}} attachedfiles, block_mark_manager {{/str}}
        </h6>
        {{#hasfiles}}
            <ul class="list-group">
                {{#files}}
                    <li class="list-group-item d-flex justify-content-between align-items-center p-2">
                        <a href="{{url}}" target="_blank" class="text-break">
                            <i class="fa fa-file mr-2"></i> {{filename}}
                        </a>
                        <span class="badge badge-light badge-pill">{{mimetype}}</span>
                    </li>
                {{/files}}
            </ul>
        {{/hasfiles}}
        {{^hasfiles}}
            <div class="text-muted font-italic p-2">
                {{#str}} nofiles, block_mark_manager {{/str}}
            </div>
        {{/hasfiles}}
    </div>

    <div class="mm-grading-block mt-4">
        <div class="form-group">
            <label for="mm-grade-input" class="font-weight-bold">
                {{#str}} gradevalue, block_mark_manager {{/str}}
            </label>
            <input type="number"
                   class="form-control"
                   id="mm-grade-input"
                   name="grade"
                   min="{{mingrade}}"
                   max="{{maxgrade}}"
                   step="0.01"
                   value="{{#hasgrade}}{{grade}}{{/hasgrade}}"
                   placeholder="0 — {{maxgrade}}">
            <small class="form-text text-muted">
                {{#str}} graderange, block_mark_manager, {"min": "{{mingrade}}", "max": "{{maxgrade}}"} {{/str}}
            </small>
        </div>

        <div class="form-group">
            <label for="mm-feedback-input" class="font-weight-bold">
                {{#str}} feedback, block_mark_manager {{/str}}
            </label>
            <textarea class="form-control"
                      id="mm-feedback-input"
                      name="feedback"
                      rows="4"
                      placeholder="{{#str}} feedbackplaceholder, block_mark_manager {{/str}}"></textarea>
        </div>

        <button type="button" class="btn btn-primary btn-block mm-save-grade-btn">
            <i class="fa fa-save mr-1"></i>
            {{#str}} savegrade, block_mark_manager {{/str}}
        </button>
    </div>
</form>
{{/issubmitted}}
{{^issubmitted}}
<div class="alert alert-warning text-center my-4">
    <i class="fa fa-exclamation-triangle fa-2x mb-2 d-block"></i>
    <h5>{{#str}} submissionrequired, block_mark_manager {{/str}}</h5>
    <p class="mb-2">{{#str}} submissionrequired_desc, block_mark_manager {{/str}}</p>
    <small class="text-muted">
        <strong>{{studentname}}</strong> — {{workname}}
    </small>
</div>
{{/issubmitted}}